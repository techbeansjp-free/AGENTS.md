{
  "name": "agent-skill-chain",
  "version": "0.1.50",
  "description": ".agent-skill-chain/source を正本に各 AI ツール（Claude Code / Cursor / Gemini / Copilot / Codex）へ段階的に配備するワークフロー仕様パッケージ。強制力はツールごとに異なり（Claude Code は runtime hook で強制、他はルール配布/方針適用）、最終保証は CI audit が担う。",
  "type": "module",
  "bin": {
    "agents-md": "bin/agents-md.js"
  },
  "files": [
    ".agent-skill-chain/source/",
    "AGENTS.md",
    "CLAUDE.md",
    ".agent-skill-chain/runtime/templates/",
    "bin/",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:claude": "bash .agent-skill-chain/source/scripts/build-plugin-claude.sh",
    "build": "tsc && chmod +x bin/agents-md.js",
    "typecheck": "tsc --noEmit",
    "test": "bash test/run-all.sh",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20"
  },
  "keywords": [
    "agents",
    "ai",
    "workflow",
    "claude-code",
    "cursor",
    "skills",
    "agents-md"
  ],
  "license": "MIT",
  "author": {
    "name": "TechBeans Inc.",
    "url": "https://github.com/techbeansjp-free"
  },
  "homepage": "https://github.com/techbeansjp-free/AGENTS.md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techbeansjp-free/AGENTS.md.git"
  },
  "bugs": {
    "url": "https://github.com/techbeansjp-free/AGENTS.md/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
