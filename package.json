{
  "name": "agent-skill-chain",
  "version": "0.1.0",
  "description": ".agents を正本に各 AI ツール（Claude Code / Cursor / Gemini / Copilot / Codex）へ段階的に配備するワークフロー仕様パッケージ。強制力はツールごとに異なり（Claude Code は runtime hook で強制、他はルール配布/方針適用）、最終保証は CI audit が担う。",
  "type": "module",
  "bin": { "agents-md": "bin/agents-md.js" },
  "files": [".agents/", "AGENTS.md", "CLAUDE.md", ".workflow/templates/", "bin/", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": { "build:claude": "bash .agents/scripts/build-plugin-claude.sh", "build": "tsc && chmod +x bin/agents-md.js", "typecheck": "tsc --noEmit", "test": "bash test/run-all.sh" },
  "devDependencies": { "typescript": "^5", "@types/node": "^20" },
  "keywords": ["agents", "ai", "workflow", "claude-code", "cursor", "skills", "agents-md"],
  "license": "MIT",
  "author": { "name": "TechBeans Inc.", "url": "https://github.com/techbeansjp-free" },
  "homepage": "https://github.com/techbeansjp-free/AGENTS.md#readme",
  "repository": { "type": "git", "url": "git+https://github.com/techbeansjp-free/AGENTS.md.git" },
  "bugs": { "url": "https://github.com/techbeansjp-free/AGENTS.md/issues" },
  "publishConfig": { "access": "public" }
}
