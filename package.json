{
  "name": "agent-skill-chain",
  "version": "0.2.66",
  "description": "Coordination Backend（GitHub Issue/PR/Check Run、またはローカルGit管理下状態）を正本とする、ソフトウェア開発ワークフロー規律のためのagentic constitution + CLIパッケージ。",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-skill-chain": "./bin/agents-md.js"
  },
  "files": [
    "bin/",
    ".agent-skill-chain/adapters/",
    ".agent-skill-chain/ci/",
    ".agent-skill-chain/config/",
    ".agent-skill-chain/hooks/",
    ".agent-skill-chain/schemas/",
    ".agent-skill-chain/scripts/",
    ".agent-skill-chain/standards/",
    ".agent-skill-chain/templates/",
    "AGENTS.md",
    "CLAUDE.md",
    "docs/GLOSSARY.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --import tsx --test $(find test/unit test/integration -name '*.test.ts')"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsx": "^4.23.5",
    "typescript": "^7"
  },
  "keywords": [
    "agents",
    "ai",
    "workflow",
    "claude-code",
    "codex",
    "agents-md"
  ],
  "license": "MIT",
  "author": {
    "name": "TechBeans Inc.",
    "url": "https://github.com/techbeansjp-free"
  },
  "homepage": "https://github.com/techbeansjp-free/AGENTS.md#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techbeansjp-free/AGENTS.md.git"
  },
  "bugs": {
    "url": "https://github.com/techbeansjp-free/AGENTS.md/issues"
  }
}
