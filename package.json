{
  "name": "agent-skill-chain",
  "version": "0.5.0-alpha.0",
  "description": "Goal・契約・Evidenceから必要な開発作業を選ぶAI開発ハーネス。",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-skill-chain": "./v05/bin/asc-v05.mjs",
    "asc-v05": "./v05/bin/asc-v05.mjs"
  },
  "files": [
    "v05/package.json",
    "v05/bin/",
    "v05/src/",
    "v05/migration_inspect.mjs",
    "v05/README.md",
    "v05/OWNER_APPROVAL.md",
    "v05/RELEASE_READINESS.json",
    "v05/USAGE.md",
    "v05/MIGRATION_PLAN.md",
    "v05/GOAL_EXECUTION.md",
    "v05/ARCHITECTURE_DECISION_0001.md",
    "v05/ARCHITECTURE_DECISION_0002.md",
    "v05/skills/",
    "README.md"
  ],
  "scripts": {
    "build": "npm run package:check",
    "lint": "eslint v05",
    "lint:v05": "npm run lint",
    "package:check": "cd v05 && node --test test_package.mjs",
    "test": "npm --prefix v05 test",
    "quality": "npm run lint && npm test",
    "verify:distribution": "npm run quality",
    "test:v05": "npm --prefix v05 test",
    "test:legacy": "node --import tsx scripts/compile.ts && node --import tsx scripts/run_cucumber_shards.ts",
    "build:legacy": "node --import tsx scripts/compile.ts && node --import tsx scripts/build.ts"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.67.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techbeansjp-free/AGENTS.md.git"
  }
}
