{
  "name": "agent-skill-chain",
  "version": "0.3.1-beta.1",
  "description": "人とAIエージェントが使う、安全側に倒す軽量開発ワークフロー。",
  "type": "module",
  "agentSkillChain": {
    "policySchemaVersion": "0.3.1",
    "compatiblePolicySchemaVersions": ["0.3.0"],
    "deprecatedPolicySchemaAliases": {
      "0.3": "0.3.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "agent-skill-chain": "./bin/agent-skill-chain.js"
  },
  "files": [
    "bin/",
    "src/",
    ".agent-skill-chain/00_利用案内.md",
    ".agent-skill-chain/skills/",
    ".agent-skill-chain/templates/",
    ".agent-skill-chain/schemas/",
    ".agent-skill-chain/policy/",
    ".agent-skill-chain/docs/",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "directories:check": "node scripts/check_directory_guides.js",
    "skills:check": "node scripts/check_skill_templates.js",
    "typecheck": "tsc --noEmit",
    "docs:format": "python3 scripts/check_japanese_docs.py",
    "test:format": "python3 scripts/check_gherkin_format.py",
    "package:check": "python3 scripts/check_package_contents.py",
    "test": "cucumber-js --config cucumber.mjs",
    "test:unit": "cucumber-js --config cucumber.mjs --tags @unit",
    "test:integration": "cucumber-js --config cucumber.mjs --tags @integration",
    "test:e2e": "cucumber-js --config cucumber.mjs --tags @e2e",
    "trace:check": "node scripts/check_trace.js",
    "architecture:check": "node scripts/check_dependency_graph.js",
    "audit:check": "node scripts/check_file_audit.js",
    "conformance:check": "node scripts/check_conformance.js",
    "prepack": "npm run build && npm run docs:format && npm run typecheck && npm run test:format && npm run trace:check && npm run architecture:check && npm test && npm run conformance:check && npm run audit:check && npm run package:check"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techbeansjp-free/AGENTS.md.git"
  }
}
