{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts", "bin/**/*.ts"],
  "exclude": [
    "scripts",
    "test",
    "dist",
    "node_modules",
    "src/domain/laya-private-corpus.ts",
    "src/adapters/laya-private-corpus.ts"
  ]
}
