{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "AGENT_ROLE": "orchestrator",
    "AGENTS_ROOT": "${CLAUDE_PROJECT_DIR}/.agents"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AGENTS_ROOT=\"${CLAUDE_PROJECT_DIR}/.agents\" AGENT_ROLE=\"${AGENT_ROLE:-orchestrator}\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/PreToolUse.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AGENTS_ROOT=\"${CLAUDE_PROJECT_DIR}/.agents\" bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/PostToolUse.sh\""
          }
        ]
      }
    ]
  }
}
