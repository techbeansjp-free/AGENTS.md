{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/project-policy-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policy",
    "choiceFiles",
    "ruleFiles",
    "conformanceFiles",
    "conformanceDirectory"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-skill-chain/project-policy-manifest/v1"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "delivery", "merge", "budgets"],
      "properties": {
        "schemaVersion": { "const": "agent-skill-chain/project-policy/v0.3.1" },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stopAt"],
          "properties": { "stopAt": { "const": "pull_request" } }
        },
        "merge": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": ["branchMethods"],
                "properties": {
                  "branchMethods": {
                    "contains": {
                      "required": ["methods"],
                      "properties": {
                        "methods": { "contains": { "const": "merge" } }
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "methods": { "contains": { "const": "merge" } }
                }
              }
            },
            {
              "if": {
                "required": ["branchMethods"],
                "properties": {
                  "branchMethods": {
                    "contains": {
                      "required": ["methods"],
                      "properties": {
                        "methods": { "contains": { "const": "squash" } }
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "methods": { "contains": { "const": "squash" } }
                }
              }
            },
            {
              "if": {
                "required": ["branchMethods"],
                "properties": {
                  "branchMethods": {
                    "contains": {
                      "required": ["methods"],
                      "properties": {
                        "methods": { "contains": { "const": "rebase" } }
                      }
                    }
                  }
                }
              },
              "then": {
                "properties": {
                  "methods": { "contains": { "const": "rebase" } }
                }
              }
            }
          ],
          "required": [
            "mode",
            "branches",
            "methods",
            "requiredChecks",
            "requiredReviews"
          ],
          "properties": {
            "mode": { "enum": ["disabled", "assisted", "automatic"] },
            "branches": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "methods": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["merge", "squash", "rebase"] }
            },
            "branchMethods": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["branches", "methods"],
                "properties": {
                  "branches": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "methods": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "enum": ["merge", "squash", "rebase"] }
                  }
                }
              }
            },
            "requiredChecks": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "requiredReviews": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            }
          }
        },
        "budgets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["localFeedbackMs", "prGateMs"],
          "properties": {
            "localFeedbackMs": { "type": "integer", "minimum": 1 },
            "prGateMs": { "type": "integer", "minimum": 1 }
          }
        },
        "worktree": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "root",
            "namePattern",
            "branchPattern",
            "allowedBranchTypes",
            "base",
            "cleanup"
          ],
          "properties": {
            "root": { "const": ".worktrees" },
            "namePattern": {
              "const": "{timestamp}-{issueNumber}-{slug}"
            },
            "branchPattern": { "const": "{type}/{issueNumber}-{slug}" },
            "allowedBranchTypes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,31}$"
              }
            },
            "base": { "const": "remote-default-branch" },
            "cleanup": { "const": "after-merge" },
            "finalizeIgnoredPathAllowlist": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*[\\\\*?\\[\\]{}()|^$+])(?:[A-Za-z0-9._-]+/)+$"
              }
            }
          }
        }
      }
    },
    "choiceFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^project/choices/[a-z0-9][a-z0-9.-]*\\.json$"
      }
    },
    "ruleFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 126,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^project/rules/[a-z0-9][a-z0-9.-]*\\.json$"
      }
    },
    "conformanceFiles": {
      "type": "array",
      "maxItems": 126,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^project/conformance/[a-z0-9][a-z0-9.-]*\\.json$"
      }
    },
    "conformanceScope": {
      "enum": ["repository-bound", "package-attested"],
      "default": "repository-bound"
    },
    "providerFiles": {
      "type": "array",
      "maxItems": 126,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^project/providers/[a-z0-9][a-z0-9.-]*\\.json$"
      }
    },
    "conformanceDirectory": { "const": "project/conformance" }
  },
  "allOf": [
    {
      "if": {
        "required": ["conformanceScope"],
        "properties": {
          "conformanceScope": { "const": "package-attested" }
        }
      },
      "then": {
        "properties": { "conformanceFiles": { "maxItems": 0 } }
      },
      "else": {
        "properties": { "conformanceFiles": { "minItems": 1 } }
      }
    }
  ]
}
