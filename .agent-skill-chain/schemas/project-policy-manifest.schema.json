{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/project-policy-manifest-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "policy", "choiceFiles", "ruleFiles", "conformanceFiles", "conformanceDirectory"],
  "properties": {
    "schemaVersion": { "const": "agent-skill-chain/project-policy-manifest/v1" },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "delivery", "merge", "budgets"],
      "properties": {
        "schemaVersion": { "const": "agent-skill-chain/project-policy/v0.4" },
        "delivery": { "type": "object", "additionalProperties": false, "required": ["stopAt"], "properties": { "stopAt": { "const": "pull_request" } } },
        "merge": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "branches", "methods", "requiredChecks", "requiredReviews"],
          "properties": {
            "mode": { "enum": ["disabled", "assisted", "automatic"] },
            "branches": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "methods": { "type": "array", "uniqueItems": true, "items": { "enum": ["merge", "squash", "rebase"] } },
            "requiredChecks": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "requiredReviews": { "type": "integer", "minimum": 0, "maximum": 20 }
          }
        },
        "budgets": {
          "type": "object", "additionalProperties": false, "required": ["localFeedbackMs", "prGateMs"],
          "properties": { "localFeedbackMs": { "type": "integer", "minimum": 1 }, "prGateMs": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "choiceFiles": { "type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^project/choices/[a-z0-9][a-z0-9.-]*\\.json$" } },
    "ruleFiles": { "type": "array", "minItems": 1, "maxItems": 126, "uniqueItems": true, "items": { "type": "string", "pattern": "^project/rules/[a-z0-9][a-z0-9.-]*\\.json$" } },
    "conformanceFiles": { "type": "array", "minItems": 1, "maxItems": 126, "uniqueItems": true, "items": { "type": "string", "pattern": "^project/conformance/[a-z0-9][a-z0-9.-]*\\.json$" } },
    "conformanceDirectory": { "const": "project/conformance" }
  }
}
