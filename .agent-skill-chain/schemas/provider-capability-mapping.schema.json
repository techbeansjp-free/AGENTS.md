{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/provider-capability-mapping-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingVersion", "providers"],
  "properties": {
    "schemaVersion": {
      "const": "agent-skill-chain/provider-capability-mapping/v1"
    },
    "mappingVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "models"],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
          },
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slug", "capabilities", "rank"],
              "properties": {
                "slug": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
                },
                "capabilities": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                  }
                },
                "rank": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  }
}
