{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/provider-capability-mapping-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mappingVersion", "providers"],
  "properties": {
    "schemaVersion": {
      "const": "agent-skill-chain/provider-capability-mapping/v2"
    },
    "mappingVersion": { "type": "string", "minLength": 1, "maxLength": 128 },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider", "capabilities", "selectionSource"],
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$"
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          },
          "selectionSource": {
            "const": "provider_recommended_default"
          }
        }
      }
    }
  }
}
