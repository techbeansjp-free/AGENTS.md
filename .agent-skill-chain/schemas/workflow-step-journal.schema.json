{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techbeansjp-free/AGENTS.md/blob/main/.agent-skill-chain/schemas/workflow-step-journal.schema.json",
  "title": "Workflow step journal entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step",
    "skillId",
    "mode",
    "recordedAt",
    "artifacts",
    "evidence"
  ],
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11
    },
    "skillId": {
      "enum": [
        "step-00-stage",
        "step-01-request",
        "step-02-requirements",
        "step-03-requirements-review",
        "step-04-issue-sync",
        "step-05-design",
        "step-06-plan",
        "step-07-design-review",
        "step-08-design-sync",
        "step-09-implement",
        "step-10-review",
        "step-11-pr"
      ]
    },
    "mode": {
      "enum": ["quick", "full", "poc"]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "implementationHeadSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "pocObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headSha", "evidenceDigest"],
      "properties": {
        "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "evidenceDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reviewSession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "roundDigest", "headSha"],
      "properties": {
        "sessionId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "roundDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "headSha": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      }
    },
    "humanOverride": {
      "$ref": "#/$defs/humanOverride"
    },
    "postTerminalIntake": {
      "const": true
    },
    "postPrIntake": {
      "const": true
    },
    "reconfirmation": {
      "description": "旧上流再確定entry。読取り互換のためだけに受理し、新規には書き込まない（REQ-WF-036）",
      "const": true
    },
    "planSeal": {
      "description": "計画封印。fullのStep 8、quick/pocのStep 4の記録時にCLIが計画文書から計算したSHA-256（REQ-WF-036）",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "00_要求定義.md": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "01_要件定義.md": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "02_設計.md": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "03_実装計画.md": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "planGeneration": {
      "description": "計画世代。封印後のStep 9・10の記録時にCLIが05_計画変更.mdから計算した追記専用の世代chain。世代1は封印（previousDigest=null、digestは封印digest）、世代2以降のdigestはsha256(stableJson({previousDigest, amendments}))（REQ-WF-036）",
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "previousDigest", "amendments", "digest"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "previousDigest": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          ]
        },
        "amendments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "digest"],
            "properties": {
              "id": { "type": "string", "pattern": "^AMD-\\d{3}$" },
              "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "step": { "const": 10 } },
        "required": ["step"]
      },
      "else": { "not": { "required": ["postTerminalIntake"] } }
    },
    {
      "if": {
        "properties": { "step": { "const": 10 } },
        "required": ["step"]
      },
      "else": { "not": { "required": ["postPrIntake"] } }
    },
    {
      "not": { "required": ["postTerminalIntake", "postPrIntake"] }
    },
    {
      "if": {
        "properties": { "step": { "minimum": 1, "maximum": 9 } },
        "required": ["step"]
      },
      "else": { "not": { "required": ["reconfirmation"] } }
    },
    {
      "if": { "properties": { "step": { "const": 9 } } },
      "else": { "not": { "required": ["implementationHeadSha"] } }
    },
    {
      "if": {
        "properties": { "step": { "enum": [9, 10] } },
        "required": ["step"]
      },
      "else": { "not": { "required": ["planGeneration"] } }
    },
    {
      "if": {
        "properties": { "mode": { "const": "full" }, "step": { "const": 8 } },
        "required": ["mode", "step"]
      },
      "then": {
        "properties": {
          "planSeal": {
            "required": [
              "00_要求定義.md",
              "01_要件定義.md",
              "02_設計.md",
              "03_実装計画.md"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": { "enum": ["quick", "poc"] },
          "step": { "const": 4 }
        },
        "required": ["mode", "step"]
      },
      "then": {
        "properties": {
          "planSeal": {
            "required": ["00_要求定義.md"],
            "maxProperties": 1
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "mode": { "const": "full" },
              "step": { "const": 8 }
            },
            "required": ["mode", "step"]
          },
          {
            "properties": {
              "mode": { "enum": ["quick", "poc"] },
              "step": { "const": 4 }
            },
            "required": ["mode", "step"]
          }
        ]
      },
      "else": { "not": { "required": ["planSeal"] } }
    },
    {
      "if": {
        "properties": {
          "mode": { "const": "poc" },
          "step": { "minimum": 9 }
        },
        "required": ["mode", "step"]
      },
      "then": { "required": ["pocObservation"] },
      "else": { "not": { "required": ["pocObservation"] } }
    },
    {
      "if": {
        "properties": { "step": { "const": 10 } },
        "required": ["step"]
      },
      "then": { "required": ["reviewSession"] },
      "else": { "not": { "required": ["reviewSession"] } }
    },
    {
      "if": { "properties": { "step": { "const": 0 } } },
      "then": { "properties": { "skillId": { "const": "step-00-stage" } } }
    },
    {
      "if": { "properties": { "step": { "const": 1 } } },
      "then": { "properties": { "skillId": { "const": "step-01-request" } } }
    },
    {
      "if": { "properties": { "step": { "const": 2 } } },
      "then": {
        "properties": { "skillId": { "const": "step-02-requirements" } }
      }
    },
    {
      "if": { "properties": { "step": { "const": 3 } } },
      "then": {
        "properties": { "skillId": { "const": "step-03-requirements-review" } }
      }
    },
    {
      "if": { "properties": { "step": { "const": 4 } } },
      "then": { "properties": { "skillId": { "const": "step-04-issue-sync" } } }
    },
    {
      "if": { "properties": { "step": { "const": 5 } } },
      "then": { "properties": { "skillId": { "const": "step-05-design" } } }
    },
    {
      "if": { "properties": { "step": { "const": 6 } } },
      "then": { "properties": { "skillId": { "const": "step-06-plan" } } }
    },
    {
      "if": { "properties": { "step": { "const": 7 } } },
      "then": {
        "properties": { "skillId": { "const": "step-07-design-review" } }
      }
    },
    {
      "if": { "properties": { "step": { "const": 8 } } },
      "then": {
        "properties": { "skillId": { "const": "step-08-design-sync" } }
      }
    },
    {
      "if": { "properties": { "step": { "const": 9 } } },
      "then": { "properties": { "skillId": { "const": "step-09-implement" } } }
    },
    {
      "if": { "properties": { "step": { "const": 10 } } },
      "then": { "properties": { "skillId": { "const": "step-10-review" } } }
    },
    {
      "if": { "properties": { "step": { "const": 11 } } },
      "then": { "properties": { "skillId": { "const": "step-11-pr" } } }
    }
  ],
  "$defs": {
    "humanOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue",
        "scope",
        "instructedBy",
        "instructedAt",
        "expiresAt",
        "reason"
      ],
      "properties": {
        "issue": { "type": "integer", "minimum": 1 },
        "scope": { "const": "workflow.pr.create" },
        "instructedBy": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "instructedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    }
  }
}
