{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/project-conformance-binding-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bindings"],
  "properties": {
    "schemaVersion": { "const": "agent-skill-chain/project-conformance/v1" },
    "bindings": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "allOf": [
        {
          "contains": {
            "properties": { "id": { "const": "I1" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I2" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I3" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I4" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I5" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I6" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I7" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I8" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I9" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I10" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I11" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": { "id": { "const": "I12" } },
            "required": ["id"]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "pattern": "^I(?:[1-9]|1[0-2])$" },
          "status": { "enum": ["applicable", "not-applicable"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "sourcePaths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "enforcement": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "export"],
                  "properties": {
                    "kind": { "const": "module-export" },
                    "path": { "$ref": "#/$defs/safePath" },
                    "export": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "path", "runner"],
                  "properties": {
                    "kind": { "const": "file-entrypoint" },
                    "path": { "$ref": "#/$defs/safePath" },
                    "runner": { "type": "string", "minLength": 1 }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "checkId"],
                  "properties": {
                    "kind": { "const": "check-ref" },
                    "checkId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,63}$"
                    }
                  }
                }
              ]
            }
          },
          "counterexampleScenarios": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^SCN-[A-Z0-9-]+$" }
          }
        },
        "allOf": [
          {
            "if": {
              "required": ["status"],
              "properties": { "status": { "const": "not-applicable" } }
            },
            "then": {
              "required": ["reason", "evidence"],
              "not": {
                "anyOf": [
                  { "required": ["sourcePaths"] },
                  { "required": ["enforcement"] },
                  { "required": ["counterexampleScenarios"] }
                ]
              }
            },
            "else": {
              "required": [
                "sourcePaths",
                "enforcement",
                "counterexampleScenarios"
              ],
              "not": {
                "anyOf": [
                  { "required": ["reason"] },
                  { "required": ["evidence"] }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "safePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\/$)[^\\u0000]+$"
    }
  }
}
