{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techbeansjp-free/AGENTS.md/schemas/project-policy-v0.3.1.json",
  "title": "agent-skill-chain risk比例型project policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "delivery", "merge"],
  "properties": {
    "schemaVersion": {
      "enum": [
        "agent-skill-chain/project-policy/v0.3.0",
        "agent-skill-chain/project-policy/v0.3.1"
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stopAt"],
      "properties": { "stopAt": { "const": "pull_request" } }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "branches",
        "methods",
        "requiredChecks",
        "requiredReviews"
      ],
      "properties": {
        "mode": { "enum": ["disabled", "assisted", "automatic"] },
        "branches": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 32,
          "uniqueItems": true
        },
        "methods": {
          "type": "array",
          "items": { "enum": ["merge", "squash", "rebase"] },
          "uniqueItems": true
        },
        "requiredChecks": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "requiredReviews": { "type": "integer", "minimum": 0, "maximum": 20 }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["localFeedbackMs", "prGateMs"],
      "properties": {
        "localFeedbackMs": { "type": "integer", "minimum": 1 },
        "prGateMs": { "type": "integer", "minimum": 1 }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "namePattern",
        "branchPattern",
        "allowedBranchTypes",
        "base",
        "cleanup"
      ],
      "properties": {
        "root": { "const": ".worktrees" },
        "namePattern": { "const": "{timestamp}-{issueNumber}-{slug}" },
        "branchPattern": { "const": "{type}/{issueNumber}-{slug}" },
        "allowedBranchTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          }
        },
        "base": { "const": "remote-default-branch" },
        "cleanup": { "const": "after-merge" },
        "finalizeIgnoredPathAllowlist": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*[\\\\*?\\[\\]{}()|^$+])(?:[A-Za-z0-9._-]+/)+$"
          }
        }
      }
    },
    "projectChoices": { "$ref": "#/$defs/projectChoices" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "agent-skill-chain/project-policy/v0.3.1"
          }
        }
      },
      "then": { "required": ["budgets", "rules"] },
      "else": {
        "not": {
          "anyOf": [
            { "required": ["budgets"] },
            { "required": ["rules"] },
            { "required": ["worktree"] },
            { "required": ["projectChoices"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "roleModelChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "logicalTier", "reasoningEffort", "speed"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "logicalTier": {
          "enum": ["project_default", "highest_available"]
        },
        "reasoningEffort": { "const": "high" },
        "speed": { "const": "standard" }
      }
    },
    "reviewerRoleModelChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "logicalTier",
        "reasoningEffort",
        "speed",
        "independence"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "logicalTier": {
          "enum": ["project_default", "highest_available"]
        },
        "reasoningEffort": { "const": "high" },
        "speed": { "const": "standard" },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["differentFrom"],
          "properties": {
            "differentFrom": { "const": "implementer" }
          }
        }
      }
    },
    "projectChoices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "testRunner",
        "gherkinDialect",
        "testLayers",
        "forbiddenTestFileSuffixes",
        "naming",
        "packageManager",
        "runtime",
        "ci",
        "release",
        "projectKind",
        "capabilities",
        "quality"
      ],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "testRunner": { "type": "string", "minLength": 1 },
        "gherkinDialect": { "type": "string", "minLength": 1 },
        "testLayers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenTestFileSuffixes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9._-]+$" }
        },
        "naming": { "type": "string", "minLength": 1 },
        "packageManager": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "ci": { "type": "string", "minLength": 1 },
        "modelMapping": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "roles",
                "fallback",
                "evidenceStoreRoot",
                "retention"
              ],
              "properties": {
                "roles": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["coordinator", "implementer", "reviewer"],
                  "properties": {
                    "coordinator": { "$ref": "#/$defs/roleModelChoice" },
                    "implementer": { "$ref": "#/$defs/roleModelChoice" },
                    "reviewer": { "$ref": "#/$defs/reviewerRoleModelChoice" }
                  }
                },
                "fallback": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["when", "role", "modelSelection"],
                  "properties": {
                    "when": { "const": "implementer_unavailable" },
                    "role": { "const": "coordinator" },
                    "modelSelection": { "const": "project_default" }
                  }
                },
                "evidenceStoreRoot": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 512,
                  "pattern": "^(?!/)(?!\\.\\./)(?!.*\\/\\.\\.\\/)(?!.*\\\\)(?:[A-Za-z0-9._-]+\\/)+$"
                },
                "retention": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "retentionDays",
                    "maxRecordsPerIssue",
                    "maxRecordBytes",
                    "rotationCondition",
                    "deletionMethod"
                  ],
                  "properties": {
                    "retentionDays": { "type": "integer", "minimum": 1 },
                    "maxRecordsPerIssue": { "type": "integer", "minimum": 1 },
                    "maxRecordBytes": { "type": "integer", "minimum": 1 },
                    "rotationCondition": { "const": "oldest_first" },
                    "deletionMethod": { "const": "preview_then_explicit" }
                  }
                }
              }
            }
          ]
        },
        "release": { "type": "string", "minLength": 1 },
        "projectKind": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "privacySecurity",
            "observability",
            "humanCenteredUi",
            "designTokens"
          ],
          "properties": {
            "privacySecurity": { "$ref": "#/$defs/applicability" },
            "observability": { "$ref": "#/$defs/applicability" },
            "humanCenteredUi": { "$ref": "#/$defs/applicability" },
            "designTokens": { "$ref": "#/$defs/applicability" }
          }
        },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementationLanguage",
            "strictTypecheck",
            "forbiddenTypes",
            "lintCommand",
            "formatCheckCommand",
            "formatWriteCommand",
            "typecheckCommand",
            "runtimeValidation",
            "auxiliaryLanguages"
          ],
          "properties": {
            "implementationLanguage": { "type": "string", "minLength": 1 },
            "strictTypecheck": { "const": true },
            "forbiddenTypes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "lintCommand": { "type": "string", "minLength": 1 },
            "formatCheckCommand": { "type": "string", "minLength": 1 },
            "formatWriteCommand": { "type": "string", "minLength": 1 },
            "typecheckCommand": { "type": "string", "minLength": 1 },
            "runtimeValidation": { "type": "string", "minLength": 1 },
            "auxiliaryLanguages": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/applicability" }
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence"],
      "properties": {
        "status": { "enum": ["applicable", "not-applicable"] },
        "reason": { "type": "string", "minLength": 8 },
        "evidence": { "type": "string", "minLength": 4 }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ruleId",
        "purpose",
        "riskClass",
        "scope",
        "enforcement",
        "activation",
        "owner",
        "targetLayer",
        "evidence",
        "remediation",
        "overridePolicy",
        "rollback"
      ],
      "properties": {
        "ruleId": { "type": "string", "pattern": "^ASC-[A-Z0-9-]+$" },
        "purpose": { "type": "string", "minLength": 1 },
        "riskClass": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "enforcement": {
          "enum": ["deny", "require", "assist", "warn", "record"]
        },
        "activation": { "enum": ["active", "staged", "disabled"] },
        "owner": { "type": "string", "minLength": 1 },
        "targetLayer": { "enum": ["package", "project", "spec", "evidence"] },
        "evidence": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "overridePolicy": { "enum": ["never", "bound"] },
        "rollback": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "enforcement": { "const": "deny" } },
            "required": ["enforcement"]
          },
          "then": {
            "properties": {
              "riskClass": {
                "enum": [
                  "secret",
                  "path",
                  "authority",
                  "irreversible",
                  "identity",
                  "artifact"
                ]
              },
              "overridePolicy": { "const": "never" }
            }
          }
        }
      ]
    }
  }
}
