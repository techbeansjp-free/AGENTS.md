{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techbeansjp-free/AGENTS.md/blob/main/.agent-skill-chain/schemas/workflow-mode-decision.schema.json",
  "title": "Workflow mode decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "requestedMode", "answers", "reasons", "decidedAt"],
  "properties": {
    "mode": { "enum": ["quick", "full", "poc"] },
    "requestedMode": { "enum": ["quick", "full", "poc"] },
    "answers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "Q-01",
        "Q-02",
        "Q-03",
        "Q-04",
        "Q-05",
        "Q-06",
        "Q-07",
        "Q-08"
      ],
      "properties": {
        "Q-01": { "$ref": "#/$defs/answer" },
        "Q-02": { "$ref": "#/$defs/answer" },
        "Q-03": { "$ref": "#/$defs/answer" },
        "Q-04": { "$ref": "#/$defs/answer" },
        "Q-05": { "$ref": "#/$defs/answer" },
        "Q-06": { "$ref": "#/$defs/answer" },
        "Q-07": { "$ref": "#/$defs/answer" },
        "Q-08": { "$ref": "#/$defs/answer" }
      }
    },
    "changedFiles": {
      "type": "array",
      "maxItems": 256,
      "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decidedAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "baselineHeadSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "poc": { "$ref": "#/$defs/pocDeclaration" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "poc" } },
        "required": ["mode"]
      },
      "then": { "required": ["poc"] }
    },
    {
      "if": {
        "properties": { "mode": { "const": "poc" } },
        "required": ["mode"]
      },
      "then": { "required": ["baselineHeadSha"] },
      "else": { "not": { "required": ["baselineHeadSha"] } }
    }
  ],
  "$defs": {
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "evidence"],
      "properties": {
        "answer": { "enum": [true, false, "unknown"] },
        "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "pocDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "fixture",
        "useCases",
        "scenarios",
        "observables",
        "outOfScope",
        "successCriteria",
        "abortCriteria",
        "owner",
        "highRisk"
      ],
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "fixture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "root",
            "isolationEvidence",
            "resetEvidence",
            "runner"
          ],
          "properties": {
            "id": { "type": "string", "pattern": "^FIX-[A-Z0-9][A-Z0-9-]*$" },
            "root": { "type": "string", "minLength": 1, "pattern": "\\S" },
            "isolationEvidence": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "resetEvidence": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "runner": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "path"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^RUN-[A-Z0-9][A-Z0-9-]*$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          }
        },
        "useCases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "actor", "goal"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^UC-[A-Z0-9][A-Z0-9-]*$"
              },
              "actor": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "goal": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "useCaseId", "given", "when", "then", "argv"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SCN-[A-Z0-9][A-Z0-9-]*$"
              },
              "useCaseId": {
                "type": "string",
                "pattern": "^UC-[A-Z0-9][A-Z0-9-]*$"
              },
              "given": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "when": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "then": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "argv": {
                "type": "array",
                "maxItems": 32,
                "items": { "type": "string", "maxLength": 1024 }
              }
            }
          }
        },
        "observables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "scenarioId", "kind", "expected"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^OBS-[A-Z0-9][A-Z0-9-]*$"
              },
              "scenarioId": {
                "type": "string",
                "pattern": "^SCN-[A-Z0-9][A-Z0-9-]*$"
              },
              "kind": {
                "enum": [
                  "exit-code",
                  "stdout-digest",
                  "stderr-digest",
                  "file-digest"
                ]
              },
              "expected": {
                "oneOf": [
                  { "type": "integer" },
                  { "type": "string", "pattern": "^[a-f0-9]{64}$" }
                ]
              },
              "target": { "type": "string", "minLength": 1, "pattern": "\\S" }
            },
            "allOf": [
              {
                "if": { "properties": { "kind": { "const": "exit-code" } } },
                "then": {
                  "properties": { "expected": { "const": 0 } },
                  "not": { "required": ["target"] }
                },
                "else": {
                  "properties": {
                    "expected": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              {
                "if": { "properties": { "kind": { "const": "file-digest" } } },
                "then": { "required": ["target"] },
                "else": { "not": { "required": ["target"] } }
              }
            ]
          }
        },
        "outOfScope": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "successCriteria": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "abortCriteria": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "owner": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "highRisk": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "present", "evidence"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
              "present": { "type": "boolean" },
              "evidence": { "type": "string", "minLength": 1, "pattern": "\\S" }
            }
          }
        }
      }
    }
  }
}
