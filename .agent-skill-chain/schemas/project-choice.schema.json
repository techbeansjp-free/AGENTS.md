{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/project-choice-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "testRunner",
    "gherkinDialect",
    "testLayers",
    "forbiddenTestFileSuffixes",
    "naming",
    "packageManager",
    "runtime",
    "ci",
    "modelMapping",
    "release",
    "projectKind",
    "capabilities",
    "quality"
  ],
  "properties": {
    "language": { "type": "string", "minLength": 1 },
    "testRunner": { "type": "string", "minLength": 1 },
    "gherkinDialect": { "type": "string", "minLength": 1 },
    "testLayers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenTestFileSuffixes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9._-]+$" }
    },
    "naming": { "type": "string", "minLength": 1 },
    "packageManager": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "ci": { "type": "string", "minLength": 1 },
    "modelMapping": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "minLength": 1 },
    "projectKind": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacySecurity",
        "observability",
        "humanCenteredUi",
        "designTokens"
      ],
      "properties": {
        "privacySecurity": { "$ref": "#/$defs/applicability" },
        "observability": { "$ref": "#/$defs/applicability" },
        "humanCenteredUi": { "$ref": "#/$defs/applicability" },
        "designTokens": { "$ref": "#/$defs/applicability" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationLanguage",
        "strictTypecheck",
        "forbiddenTypes",
        "lintCommand",
        "formatCheckCommand",
        "formatWriteCommand",
        "typecheckCommand",
        "runtimeValidation",
        "auxiliaryLanguages"
      ],
      "properties": {
        "implementationLanguage": { "type": "string", "minLength": 1 },
        "strictTypecheck": { "const": true },
        "forbiddenTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lintCommand": { "type": "string", "minLength": 1 },
        "formatCheckCommand": { "type": "string", "minLength": 1 },
        "formatWriteCommand": { "type": "string", "minLength": 1 },
        "typecheckCommand": { "type": "string", "minLength": 1 },
        "runtimeValidation": { "type": "string", "minLength": 1 },
        "auxiliaryLanguages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/applicability" }
        }
      }
    }
  },
  "$defs": {
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence"],
      "properties": {
        "status": { "enum": ["applicable", "not-applicable"] },
        "reason": { "type": "string", "minLength": 8 },
        "evidence": { "type": "string", "minLength": 4 }
      }
    }
  }
}
