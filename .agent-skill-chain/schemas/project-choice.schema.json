{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/project-choice-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "testRunner",
    "gherkinDialect",
    "testLayers",
    "forbiddenTestFileSuffixes",
    "naming",
    "packageManager",
    "runtime",
    "ci",
    "release",
    "projectKind",
    "capabilities",
    "quality"
  ],
  "properties": {
    "language": { "type": "string", "minLength": 1 },
    "testRunner": { "type": "string", "minLength": 1 },
    "gherkinDialect": { "type": "string", "minLength": 1 },
    "testLayers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenTestFileSuffixes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9._-]+$" }
    },
    "naming": { "type": "string", "minLength": 1 },
    "packageManager": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "ci": { "type": "string", "minLength": 1 },
    "modelMapping": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["roles", "fallback", "evidenceStoreRoot", "retention"],
          "properties": {
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": ["coordinator", "implementer", "reviewer"],
              "properties": {
                "coordinator": { "$ref": "#/$defs/roleModelChoice" },
                "implementer": { "$ref": "#/$defs/roleModelChoice" },
                "reviewer": { "$ref": "#/$defs/reviewerRoleModelChoice" }
              }
            },
            "fallback": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when", "role", "modelSelection"],
              "properties": {
                "when": { "const": "implementer_unavailable" },
                "role": { "const": "coordinator" },
                "modelSelection": { "const": "project_default" }
              }
            },
            "evidenceStoreRoot": {
              "type": "string",
              "minLength": 2,
              "maxLength": 512,
              "pattern": "^(?!/)(?!\\.\\./)(?!.*\\/\\.\\.\\/)(?!.*\\\\)(?:[A-Za-z0-9._-]+\\/)+$"
            },
            "retention": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "retentionDays",
                "maxRecordsPerIssue",
                "maxRecordBytes",
                "rotationCondition",
                "deletionMethod"
              ],
              "properties": {
                "retentionDays": { "type": "integer", "minimum": 1 },
                "maxRecordsPerIssue": { "type": "integer", "minimum": 1 },
                "maxRecordBytes": { "type": "integer", "minimum": 1 },
                "rotationCondition": { "const": "oldest_first" },
                "deletionMethod": { "const": "preview_then_explicit" }
              }
            },
            "roleContracts": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "enum": [
                  "coordinator",
                  "analyst",
                  "implementer",
                  "reviewer",
                  "verifier",
                  "finalizer"
                ]
              },
              "additionalProperties": { "$ref": "#/$defs/roleContract" }
            },
            "tierMapping": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/modelTier" }
            },
            "minimumTierByRisk": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "$ref": "#/$defs/modelTier" }
            }
          }
        }
      ]
    },
    "release": { "type": "string", "minLength": 1 },
    "projectKind": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacySecurity",
        "observability",
        "humanCenteredUi",
        "designTokens"
      ],
      "properties": {
        "privacySecurity": { "$ref": "#/$defs/applicability" },
        "observability": { "$ref": "#/$defs/applicability" },
        "humanCenteredUi": { "$ref": "#/$defs/applicability" },
        "designTokens": { "$ref": "#/$defs/applicability" }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationLanguage",
        "strictTypecheck",
        "forbiddenTypes",
        "lintCommand",
        "formatCheckCommand",
        "formatWriteCommand",
        "typecheckCommand",
        "runtimeValidation",
        "auxiliaryLanguages"
      ],
      "properties": {
        "implementationLanguage": { "type": "string", "minLength": 1 },
        "strictTypecheck": {
          "oneOf": [{ "const": true }, { "$ref": "#/$defs/notApplicable" }]
        },
        "forbiddenTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "lintCommand": { "$ref": "#/$defs/qualityValue" },
        "formatCheckCommand": { "$ref": "#/$defs/qualityValue" },
        "formatWriteCommand": { "$ref": "#/$defs/qualityValue" },
        "typecheckCommand": { "$ref": "#/$defs/qualityValue" },
        "runtimeValidation": { "$ref": "#/$defs/qualityValue" },
        "auxiliaryLanguages": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/applicability" }
        }
      }
    }
  },
  "$defs": {
    "modelTier": {
      "enum": ["routine", "standard", "advanced", "critical"]
    },
    "roleContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPaths",
        "allowedOperations",
        "forbiddenOperations",
        "requiredEvidence"
      ],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "allowedOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "forbiddenOperations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requiredEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "roleModelChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "logicalTier", "reasoningEffort", "speed"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "logicalTier": {
          "enum": ["project_default", "highest_available"]
        },
        "reasoningEffort": { "const": "high" },
        "speed": { "const": "standard" }
      }
    },
    "reviewerRoleModelChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "logicalTier",
        "reasoningEffort",
        "speed",
        "independence"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "logicalTier": {
          "enum": ["project_default", "highest_available"]
        },
        "reasoningEffort": { "const": "high" },
        "speed": { "const": "standard" },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["differentFrom"],
          "properties": {
            "differentFrom": { "const": "implementer" }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "evidence"],
      "properties": {
        "status": { "enum": ["applicable", "not-applicable"] },
        "reason": { "type": "string", "minLength": 8 },
        "evidence": { "type": "string", "minLength": 4 }
      }
    },
    "notApplicable": {
      "allOf": [
        { "$ref": "#/$defs/applicability" },
        {
          "type": "object",
          "properties": { "status": { "const": "not-applicable" } }
        }
      ]
    },
    "qualityValue": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "$ref": "#/$defs/notApplicable" }
      ]
    }
  }
}
