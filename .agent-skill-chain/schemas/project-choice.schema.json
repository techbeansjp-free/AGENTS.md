{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skill-chain.invalid/schemas/project-choice-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "testRunner", "testLayers", "forbiddenTestFileSuffixes", "naming", "packageManager", "runtime", "ci", "modelMapping", "release"],
  "properties": {
    "language": { "type": "string", "minLength": 1 },
    "testRunner": { "type": "string", "minLength": 1 },
    "testLayers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "forbiddenTestFileSuffixes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9._-]+$" } },
    "naming": { "type": "string", "minLength": 1 },
    "packageManager": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "ci": { "type": "string", "minLength": 1 },
    "modelMapping": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "minLength": 1 }
  }
}
