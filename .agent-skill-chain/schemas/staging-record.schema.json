{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techbeansjp-free/AGENTS.md/.agent-skill-chain/schemas/staging-record.schema.json",
  "title": "一時ステージング記録",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "artifacts",
    "digest",
    "owner",
    "createdAt",
    "state",
    "tracker",
    "checkpoint",
    "syncedAt",
    "syncDigest",
    "readBackDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "agent-skill-chain/staging-record/v1"
    },
    "mode": {
      "enum": ["quick", "full", "poc"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!staging-record\\.json$)[^\\u0000-\\u001f\\u007f\\\\]+$"
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owner": {
      "const": "runtime・project owner"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": ["local-active", "sync-verified"]
    },
    "tracker": {
      "type": ["string", "null"],
      "pattern": "^(?:https://github\\.com/[^/\\s]+/[^/\\s]+/issues/[1-9][0-9]*|#?[1-9][0-9]*)$"
    },
    "checkpoint": {
      "enum": [4, 8, null]
    },
    "syncedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "syncDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    },
    "readBackDigest": {
      "type": ["string", "null"],
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "local-active" } } },
      "then": {
        "properties": {
          "tracker": { "type": "null" },
          "checkpoint": { "type": "null" },
          "syncedAt": { "type": "null" },
          "syncDigest": { "type": "null" },
          "readBackDigest": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "state": { "const": "sync-verified" } } },
      "then": {
        "properties": {
          "tracker": { "type": "string" },
          "checkpoint": { "type": "integer" },
          "syncedAt": { "type": "string" },
          "syncDigest": { "type": "string" },
          "readBackDigest": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "enum": ["quick", "poc"] } } },
      "then": { "properties": { "checkpoint": { "enum": [4, null] } } }
    },
    {
      "if": { "properties": { "mode": { "const": "full" } } },
      "then": { "properties": { "checkpoint": { "enum": [8, null] } } }
    }
  ]
}
