{
  "language": "日本語",
  "testRunner": "cucumber-js",
  "gherkinDialect": "en",
  "testLayers": ["unit", "integration", "e2e"],
  "forbiddenTestFileSuffixes": [".test.js", ".test.ts"],
  "naming": "連番付き日本語Markdownと一意なSCN ID",
  "packageManager": "npm",
  "runtime": "Node.js 20以上",
  "ci": ".github/workflows/ci.yml",
  "modelMapping": {
    "roles": {
      "coordinator": {
        "provider": "claude",
        "logicalTier": "project_default",
        "reasoningEffort": "high",
        "speed": "standard"
      },
      "implementer": {
        "provider": "codex",
        "logicalTier": "highest_available",
        "reasoningEffort": "high",
        "speed": "standard"
      },
      "reviewer": {
        "provider": "claude",
        "logicalTier": "project_default",
        "reasoningEffort": "high",
        "speed": "standard",
        "independence": { "differentFrom": "implementer" }
      }
    },
    "roleContracts": {
      "coordinator": {
        "allowedPaths": [
          ".agent-skill-chain/tmp/",
          ".agent-skill-chain/role-log/"
        ],
        "allowedOperations": [
          "decompose_issue",
          "assign_role",
          "transition_state",
          "aggregate_evidence"
        ],
        "forbiddenOperations": [
          "implement_product",
          "self_approve",
          "merge_arbitration"
        ],
        "requiredEvidence": ["assignment_record", "state_record"]
      },
      "analyst": {
        "allowedPaths": ["docs/specs/", ".agent-skill-chain/tmp/"],
        "allowedOperations": [
          "define_requirements",
          "design",
          "define_acceptance",
          "author_gherkin"
        ],
        "forbiddenOperations": ["final_approval_of_own_scope"],
        "requiredEvidence": ["requirements_trace"]
      },
      "implementer": {
        "allowedPaths": [
          "src/",
          "test/",
          "docs/specs/",
          ".agent-skill-chain/",
          "scripts/prepare_release_bump.ts",
          ".github/workflows/release.yml"
        ],
        "allowedOperations": [
          "confirm_failing_test",
          "implement_product",
          "refactor_local",
          "run_test"
        ],
        "forbiddenOperations": ["final_review", "merge_arbitration"],
        "requiredEvidence": ["failing_test", "test_result"]
      },
      "reviewer": {
        "allowedPaths": [
          ".agent-skill-chain/role-log/",
          ".agent-skill-chain/tmp/"
        ],
        "allowedOperations": [
          "affirmative_review",
          "adversarial_review",
          "classify_finding"
        ],
        "forbiddenOperations": ["modify_target_diff", "hide_finding"],
        "requiredEvidence": [
          "affirmative_review",
          "adversarial_review",
          "finding_classification",
          "independence"
        ]
      },
      "verifier": {
        "allowedPaths": [
          ".agent-skill-chain/role-log/",
          ".agent-skill-chain/tmp/"
        ],
        "allowedOperations": [
          "run_independent_test",
          "verify_artifact",
          "verify_spec",
          "verify_remote_sha"
        ],
        "forbiddenOperations": ["implement_product", "approve_unverified"],
        "requiredEvidence": [
          "independent_test",
          "artifact_verification",
          "spec_consistency"
        ]
      },
      "finalizer": {
        "allowedPaths": [
          ".agent-skill-chain/role-log/",
          ".agent-skill-chain/tmp/"
        ],
        "allowedOperations": [
          "open_pr",
          "verify_merge",
          "update_main",
          "safe_cleanup",
          "close_issue"
        ],
        "forbiddenOperations": [
          "change_requirements",
          "implement_product",
          "alter_review_result"
        ],
        "requiredEvidence": [
          "pr_evidence",
          "merge_verification",
          "cleanup_report"
        ]
      }
    },
    "tierMapping": {
      "gpt-5.6-sol": "critical",
      "claude-opus-5": "critical"
    },
    "minimumTierByRisk": {
      "secret": "critical",
      "path": "routine",
      "authority": "critical",
      "irreversible": "critical",
      "identity": "critical",
      "artifact": "critical"
    },
    "fallback": {
      "when": "implementer_unavailable",
      "role": "coordinator",
      "modelSelection": "project_default"
    },
    "evidenceStoreRoot": "docs/evidence/routing/",
    "retention": {
      "retentionDays": 30,
      "maxRecordsPerIssue": 20,
      "maxRecordBytes": 65536,
      "rotationCondition": "oldest_first",
      "deletionMethod": "preview_then_explicit"
    }
  },
  "release": "明示authorityによる手動操作",
  "projectKind": "cli",
  "capabilities": {
    "privacySecurity": {
      "status": "applicable",
      "reason": "policy、credential、GitHub証拠を扱うCLIでありPrivacy/Security by Designを常に適用する",
      "evidence": "redaction・path・authority・artifact境界の反例BDD"
    },
    "observability": {
      "status": "applicable",
      "reason": "診断、migration journal、metrics、CI/review証拠を運用判断へ使用する",
      "evidence": "運用保守設計とwait・falseBlock・override・rollback・missの反例BDD"
    },
    "humanCenteredUi": {
      "status": "not-applicable",
      "reason": "現行製品はNode CLIでありGUIまたはWeb UIを提供しない",
      "evidence": "package.jsonのbinとCLI contract"
    },
    "designTokens": {
      "status": "not-applicable",
      "reason": "現行製品は画面レイアウトと視覚コンポーネントを所有しない",
      "evidence": "projectKind=cli、UI sourceなし"
    }
  },
  "quality": {
    "implementationLanguage": "TypeScript",
    "strictTypecheck": true,
    "forbiddenTypes": ["any"],
    "lintCommand": "npm run lint",
    "formatCheckCommand": "npm run format:check",
    "formatWriteCommand": "npm run format:write",
    "typecheckCommand": "npm run typecheck",
    "runtimeValidation": "外部JSONをunknownで読み、policy・manifest・state・evidenceの入力種別別type guardとdomain validatorで未知field・型不正を拒否する",
    "auxiliaryLanguages": {
      "python": {
        "status": "not-applicable",
        "reason": "検査3本をTypeScriptへ統合しPython実装を所有しない",
        "evidence": "scripts配下に.pyがなくTypeScript検査へ移行済み"
      },
      "shell": {
        "status": "not-applicable",
        "reason": "shell sourceを所有せずnpm scriptとTypeScriptへ処理を集約する",
        "evidence": "repositoryに.sh sourceがない"
      }
    }
  }
}
