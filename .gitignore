# macOS
.DS_Store

# Node 依存（lockfileから npm ci で再現するため追跡不要）
node_modules/

# CLI ビルド生成物（tsconfig.json outDir）
/bin/

# スクラッチ・非追跡メモ（issueドキュメント本則の外）
**/memo/*

# worktree自体（各worktree配下は独立したリポジトリとして扱われるためgit管理外。
# 空の親ディレクトリのuntracked表示のみを防ぐ）
.worktrees/

# ローカルエディタ/ツール実行系設定（配布正本は .agent-skill-chain/ 側、展開結果は追跡不要）
.claude/
