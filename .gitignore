# OSとエディタのローカル生成物
.DS_Store
*.code-workspace

# lockfileから再現する開発依存と専用worktree
node_modules/
.worktrees/

# compileが毎回削除して再生成する配布用ビルド成果物。配布はpackage.jsonのfilesが行う
dist/

# 同期前staging、失効済みlocal issue、他案件を含み得るmemo
.agent-skill-chain/tmp/

# 実行ログと開発計測の生成物。src/domain/staging.tsのSTAGING_LIFECYCLE_AREASが正本
.agent-skill-chain/role-log/
.agent-skill-chain/metrics/
/issues/
/memo/
**/memo/

# host skill adapterの展開先とその管理record。packageが生成しrepositoryは追跡しない
.claude/
.agents/
.agent-skill-chain/managed-assets.json

# ローカルツール設定と実行ログ
test-execution.log
*.log
